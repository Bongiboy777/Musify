generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Like {
  userId String
  songId String
  song   Song   @relation(fields: [songId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, songId])
  @@unique([userId, songId])
}

model Song {
  id              String     @id @default(cuid())
  title           String?
  userId          String
  seed            Float?
  fullPrompt      String?    @map("prompt")
  describedPrompt String?
  fullLyrics      String?    @map("lyrics")
  describedLyrics String?
  instrumental    Boolean    @default(false)
  s3_loc          String?    @unique
  image_s3_loc    String?    @unique
  guidanceScale   Float      @default(0.5)
  inferStep       Float      @default(0.5)
  audioDuration   Float      @default(120)
  listenCount     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  jobId           String?
  likes           Like[]
  user            User       @relation(fields: [userId], references: [id])
  categories      Category[] @relation("CategoryToSong")

  @@map("song")
}

model Job {
  id        String    @id @default(cuid())
  inngestId String    @unique
  event     String
  payload   Json
  status    JobStatus @default(QUEUED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("job")
}

model Category {
  id    String @id
  title String @unique
  songs Song[] @relation("CategoryToSong")

  @@map("category")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  credits       Int       @default(100)
  likes         Like[]
  accounts      Account[]
  sessions      Session[]
  songs         Song[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum JobStatus {
  QUEUED
  PREPARATION
  FORMATTING_PROMPT
  FORMATTING_LYRICS
  GENERATING_CATEGORIES
  GENERATING_IMAGE
  GENERATING_MUSIC
  COMPLETED
  FAILED
}
